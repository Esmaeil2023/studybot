# What `gcloud builds submit` uploads. Without this file gcloud copies .gitignore, which
# would leave out data/processed/chunks.jsonl (the image needs it).
.git
.github
.venv
.env
.env.*
__pycache__
*.pyc
.pytest_cache
.ruff_cache
indexes
results
tests
data/raw
data/eval
data/processed/*
!data/processed/chunks.jsonl
*.egg-info
.DS_Store
